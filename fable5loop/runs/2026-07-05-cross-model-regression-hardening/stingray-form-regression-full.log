ress {\n  display: none;\n}\n\n.mobile-drawer-button,\n.mobile-drawer-header,\n.mobile-drawer-backdrop {\n  display: none;\n}\n\n.mobile-drawer-button-right {\n  display: none;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-width: 0;\n  border: 1px solid var(--ghost-border);\n  background: transparent;\n  color: var(--ink);\n  box-shadow: none;\n}\n\n.toolbar .mobile-drawer-button-right {\n  display: inline-flex;\n  min-height: 44px;\n  padding: 0 14px;\n  font-size: 12.5px;\n}\n\n.mobile-drawer-button-right:hover,\n.mobile-drawer-button-right:focus-visible,\n.mobile-drawer-button-right[aria-expanded="true"] {\n  border-color: var(--accent);\n  background: var(--ghost-hover-bg);\n  color: var(--ink);\n  filter: none;\n}\n\n.summary-drawer-icon {\n  font-size: 16px;\n  line-height: 1;\n}\n\n.workspace {\n  display: grid;\n  grid-template-columns: 240px minmax(0, 1fr);\n  min-height: 760px;\n  /* clip (not hidden) so position: sticky descendants (paint vehicle stage,\n     docked summary panel) track the window scroll instead of a dead\n     scroll container */\n  overflow: clip;\n}\n\n.step-rail {\n  border-right: 1px solid var(--hairline);\n  background: var(--panel);\n  padding: 14px 12px;\n}\n\n.step-link {\n  display: grid;\n  grid-template-columns: 26px 1fr;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  min-height: 42px;\n  margin-bottom: 3px;\n  padding: 0 8px;\n  border: 1px solid transparent;\n  border-radius: 7px;\n  background: transparent;\n  color: var(--dim);\n  text-align: left;\n  font-size: 13px;\n  font-weight: 750;\n  letter-spacing: 0;\n  text-transform: none;\n  box-shadow: none;\n  transition: background 140ms ease, border-color 140ms ease, color 140ms ease;\n}\n\n.step-link:hover {\n  background: rgba(255, 255, 255, 0.04);\n  filter: none;\n}\n\n.step-link.complete {\n  color: #cfd3d6;\n}\n\n.step-link.active {\n  border-color: var(--hairline-strong);\n  background: rgba(255, 255, 255, 0.05);\n  color: var(--ac